server {
    listen 3000;
    listen [::]:3000;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location = /health {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    location = /notes {
        return 308 /notes/;
    }

    location /notes/api/ {
        rewrite ^/notes(/api/.*)$ $1 break;
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /notes/openapi.json {
        proxy_pass ${API_UPSTREAM}/openapi.json;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /notes/index.html {
        rewrite ^/notes/index\.html$ /index.html break;
        add_header Cache-Control "no-cache";
    }

    location = /notes/sw.js {
        rewrite ^/notes/sw\.js$ /sw.js break;
        add_header Cache-Control "no-cache";
    }

    location = /notes/manifest.webmanifest {
        rewrite ^/notes/manifest\.webmanifest$ /manifest.webmanifest break;
        default_type application/manifest+json;
    }

    location /notes/ {
        rewrite ^/notes/(.*)$ /$1 break;
        try_files $uri $uri/ /index.html;
    }
}
