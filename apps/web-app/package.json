{
  "name": "@note/web-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm --filter @note/api-contracts build && pnpm --filter @note/markdown-wasm build && tsc --noEmit && vite build",
    "build:web": "tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@note/api-contracts": "workspace:*",
    "@note/browser-storage": "workspace:*",
    "@note/editor": "workspace:*",
    "@note/markdown-wasm": "workspace:*",
    "@note/sync-core": "workspace:*",
    "@note/workspace-core": "workspace:*",
    "@note/workspace-drive": "workspace:*",
    "@note/workspace-local": "workspace:*",
    "@tanstack/react-query": "^5.102.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.4"
  }
}
