# Browser-visible Google Picker configuration (not secrets).
# Create an HTTP-referrer-restricted API key in Google Cloud Console.
VITE_GOOGLE_PICKER_API_KEY=AIzaSyEXAMPLE_NOT_A_REAL_KEY

# Numeric Google Cloud Project Number (not the Project ID or OAuth Client ID).
VITE_GOOGLE_APP_ID=123456789012

# Temporary cold-provider fallback. Warm cache activation is enabled unless this is set to false.
VITE_WARM_WORKSPACE_CACHE=true
