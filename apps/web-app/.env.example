# Browser-visible Google Picker configuration (not secrets).
# Create an HTTP-referrer-restricted API key in Google Cloud Console.
# For local development allow http://localhost:5173/*; also allow the exact production origin.
VITE_GOOGLE_PICKER_API_KEY=AIzaSyEXAMPLE_NOT_A_REAL_KEY

# Numeric Google Cloud Project Number (not the Project ID or OAuth Client ID).
# Enable the Google Picker and Drive APIs in this same project.
VITE_GOOGLE_APP_ID=123456789012

# Temporary cold-provider fallback. Warm cache activation is enabled unless this is set to false.
VITE_WARM_WORKSPACE_CACHE=true

# Persistent 24-hour rolling activity snapshot. Enabled automatically by Vite in development.
# Set true in a diagnostic production build to expose the browser-only viewer and bounded JSON export.
VITE_ACTIVITY_LOG_ENABLED=false

# Temporary in-memory sync breadcrumbs uploaded only after errors or slow operations.
VITE_SYNC_DIAGNOSTICS_ENABLED=false
VITE_SYNC_SLOW_ACTIVATION_MS=30000
